{
  "name": "@mnigos/platform-hono",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && bun build src/index.ts --outfile dist/index.js --target node --format esm --packages external --sourcemap=none",
    "check": "ultracite check",
    "check:fix": "ultracite fix --unsafe",
    "clean": "git clean -xdf .cache .turbo coverage dist node_modules",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hono/node-server": "^2.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@hono/node-server": "^2.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@types/bun": "^1.3.13",
    "@vitest/coverage-v8": "4.1.5",
    "hono": "^4.12.16",
    "typescript": "^6.0.3",
    "ultracite": "7.6.2",
    "vitest": "4.1.5"
  }
}
